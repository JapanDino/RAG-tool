# Copy to backend/.env and adjust values before running docker-compose.

# Database (use Docker service name "db" when running via docker-compose)
DATABASE_URL=postgresql+psycopg://rag:rag_pass@db:5432/rag_db

# Redis (use Docker service name "redis" when running via docker-compose)
REDIS_URL=redis://redis:6379/0

# Embeddings: hash (no deps, fast) | local (sentence-transformers, semantic) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-small

# Node extraction: semantic (default local) | local_ner (requires natasha) | heuristic
NODE_EXTRACTOR=semantic
# Course objective/assessment extraction: baseline | llm (validated structured output with fallback)
COURSE_ENTITY_EXTRACTOR=baseline

# Upload directory for documents
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=20971520
MAX_COURSE_DOCUMENTS=100

# Production must use an explicit comma-separated origin list, never '*'.
APP_ENV=development
# Local-only identity selector. Production must use AUTH_MODE=external and an
# approved LTI/OIDC adapter; development/disabled modes are rejected there.
AUTH_MODE=development
CORS_ALLOW_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
# Public origin used in the Canvas LTI 1.3 configuration. Production requires
# an externally reachable HTTPS origin with no path, query, or credentials.
# LTI_TOOL_PUBLIC_URL=https://assistant.school.example
# Public signing keys only. Inject a compact JWKS JSON object; private JWK
# fields are rejected. Keep the corresponding private signing key outside this
# application and outside committed configuration.
# LTI_TOOL_JWKS_JSON={"keys":[{"kty":"RSA","use":"sig","alg":"RS256","kid":"current","n":"...","e":"AQAB"}]}
# Required before activation: exact platform host allow-list. Include every
# Canvas OIDC/JWKS host used by the registration.
# LTI_ALLOWED_HOSTS=canvas.school.example
# Private Canvas hosts require a second explicit allow-list after routing and
# TLS are configured; a draft never performs DNS or network requests.
# LTI_ALLOWED_PRIVATE_HOSTS=canvas.internal.school.example
# Required in production; inject a unique value of at least 32 characters from
# the deployment secret manager. Do not commit the real value.
# LTI_SESSION_CSRF_SECRET=set-in-secret-manager
# Optional protection for all mutating API requests. Frontends must send X-API-Key.
# API_WRITE_KEY=replace-with-a-long-random-secret

# Canvas read-only import. In production, restrict imports to institutional hosts.
# CANVAS_ALLOWED_HOSTS=canvas.example.edu
CANVAS_TIMEOUT_SECONDS=20
CANVAS_MAX_API_PAGES=20

# OCR timeout per page in seconds (0 = no timeout)
OCR_PAGE_TIMEOUT_S=30

# LLM integration (optional)
ENABLE_LLM=0
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE=https://api.openai.com/v1

# Role-aware Canvas agent model boundary. Disabled by default. Keep the exact
# origin, model ID, and secret in deployment configuration; never expose them to
# the frontend or Canvas. HTTP is accepted only for an explicitly enabled local
# loopback development host.
AGENT_MODEL_ENABLED=0
# AGENT_MODEL_BASE_URL=https://models.internal.example/v1
# AGENT_MODEL_ALLOWED_HOSTS=models.internal.example
# AGENT_MODEL_ID=approved-server-model-id
# AGENT_MODEL_API_KEY=
# AGENT_MODEL_CONNECT_TIMEOUT=3
# AGENT_MODEL_READ_TIMEOUT=30
# AGENT_MODEL_RETRIES=1
# AGENT_MODEL_MAX_CONCURRENCY=4
# AGENT_MODEL_MAX_INPUT_CHARS=16000
# AGENT_MODEL_MAX_OUTPUT_TOKENS=900
# AGENT_MODEL_MAX_RESPONSE_BYTES=131072
# AGENT_MODEL_CIRCUIT_FAILURES=3
# AGENT_MODEL_CIRCUIT_COOLDOWN=30
# AGENT_MODEL_ALLOW_HTTP_LOCAL=0
# Optional server-owned flat rates for the administrator's approximate token
# cost tape. Both must be set to valid non-negative USD rates per million
# tokens; otherwise cost stays explicitly unconfigured. These are estimates,
# not credentials, provider invoices, or full infrastructure cost.
# AGENT_MODEL_INPUT_USD_PER_MILLION_TOKENS=
# AGENT_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=
# Required in production for session-scoped agent idempotency digests. Keep this
# server-only and independent from the Canvas/LTI credentials.
# AGENT_IDEMPOTENCY_SECRET=replace-with-at-least-32-random-characters
# OPENAI_API_KEY=sk-...

# Course remediation Copilot. Uses the OpenAI-compatible chat endpoint for
# structured generation; retrieval remains local and works without a GPU.
COURSE_COPILOT_ENABLED=1
COURSE_COPILOT_PROVIDER=openai
COURSE_COPILOT_MODEL=gpt-4o-mini
COURSE_COPILOT_TOP_K=5
COURSE_COPILOT_MAX_CANDIDATES=500
COURSE_COPILOT_MIN_SCORE=0.12
# Instructor Course Q&A. Defaults to the Copilot provider/model when omitted.
COURSE_QA_ENABLED=1
# COURSE_QA_PROVIDER=openai
# COURSE_QA_MODEL=gpt-4o-mini
# Built-in deterministic demo course. Disabled by default when APP_ENV=production.
ENABLE_DEMO_SEED=1

# Exact synthetic Canvas simulator. All three values are required; production
# ignores the feature even if they are accidentally set.
# CANVAS_SIMULATOR_ENABLED=true
# CANVAS_SIMULATOR_DATA_MODE=synthetic
# CANVAS_SIMULATOR_LTI_BASE_URL=http://localhost:8000
