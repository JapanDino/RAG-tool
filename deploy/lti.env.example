# Copy to backend/.env for a dedicated pilot deployment. Never commit the real file.
APP_MODE=lti
PUBLIC_BASE_URL=https://assistant.example.org
CANVAS_URL=https://canvas.example.org
CANVAS_TOKEN=replace-with-read-only-course-token
# Obtain exact platform URLs from your Canvas administrator (hosted/self-hosted differ).
LTI_ISSUER=https://canvas.instructure.com
LTI_AUTH_URL=https://canvas.example.org/api/lti/authorize_redirect
LTI_JWKS_URL=https://canvas.example.org/api/lti/security/jwks
# Fill these AFTER creating the Developer Key and installing the app in a course.
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_ALLOWED_COURSE_IDS=12345
LTI_PUBLIC_JWKS_PATH=/app/secrets/lti-public.json
CORS_ALLOW_ORIGINS=https://assistant.example.org

# Use a dedicated database and Redis instance. Compose sets host/user/database.
DB_PASS=replace-with-strong-database-password
REDIS_URL=redis://redis:6379/0
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-large
PORTAL_MIN_SIMILARITY=0.55
# Prefer an administrator-provided HTTPS reverse proxy for this upstream API.
OPENAI_BASE=http://llm.letovo.site:8809/openai
OPENAI_API_KEY=replace-with-letovo-key
LLM_MODEL=deepseek-v4-flash
OPENAI_TIMEOUT=120
BLOOM_CLASSIFIER=llm
ENABLE_LLM=1
LLM_PROVIDER=openai
NODE_EXTRACTOR=local_ner
