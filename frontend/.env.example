NEXT_PUBLIC_API_BASE=http://localhost:8000
# Local development only. Keep unset/0 in production builds.
NEXT_PUBLIC_ENABLE_PROGRAM_DEMO=1
# Local synthetic Canvas simulator. Both server-only flags are required.
# CANVAS_SIMULATOR_ENABLED=true
# CANVAS_SIMULATOR_DATA_MODE=synthetic
# Signed local launches resolve the exact seeded actor subject from the backend.
# There is no static registration fallback because it cannot preserve role isolation.
# CANVAS_SIMULATOR_LTI_BASE_URL=http://localhost:8000
